  "overrides": {
    "@types/ms": "0.7.34",
    "ioredis": "^5.11.1",
    "@songkeys/nestjs-redis": {
      "@nestjs/common": "^12.0.0",
      "@nestjs/core": "^12.0.0"
    },
    "nestjs-console": {
      "@nestjs/common": "^12.0.0",
      "@nestjs/core": "^12.0.0"
    }
